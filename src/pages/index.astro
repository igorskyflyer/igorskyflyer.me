---
import Feed from '@components/Feed.astro'
import Hero from '@components/Hero.astro'
import Me from '@components/Me.astro'
import Page from '@components/Page.astro'
import Stats from '@components/Stats.astro'
import { SiteName } from '@data/Site.ts'
---

<Page
  title={`${SiteName} (igorskyflyer) | Senior Full-Stack Software Engineer`}
  description="Portfolio and technical blog of Igor Dimitrijević (igorskyflyer), Senior Full-Stack Software Engineer specializing in TypeScript, DX tooling, and performance-first architectures."
  keywords="igorskyflyer, igor dimitrijević, full stack engineer, software engineer, typescript, javascript, astro, open source, dx tooling, web architecture, blog"
  featuredImage="https://igorskyflyer.me/assets/author/igorskyflyer.webp">
  <Fragment slot="body">
    <div class="fold-group">
      <Hero />
      <Stats />
    </div>
    <Me />
    <Feed />
  </Fragment>
</Page>

<style>
  .fold-group {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 3vw, 2rem);
  }
</style>
