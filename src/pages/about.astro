---
import Page from '@components/Page.astro'
import { SiteName } from '@data/site.ts'

const title = `About This Site & Architecture | ${SiteName}`
const description =
  'Technical architecture, build stack, and design principles behind this site. Built with Astro, static HTML output, and zero unnecessary client JS overhead.'
const keywords =
  'about site, website architecture, tech stack, astro, web performance, static site generator, chimera theme, igorskyflyer, igor dimitrijević'
const pageTitle = 'About This Site & Architecture'
const pageTagline =
  'Technical architecture, build stack, and design principles behind this site.'

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description: description,
  mainEntity: {
    '@type': 'WebSite',
    name: SiteName,
    description: 'Personal technical platform, blog, and software showcase.',
    publisher: {
      '@type': 'Person',
      name: 'Igor Dimitrijević',
      alternateName: 'igorskyflyer'
    }
  }
}
---

<Page
  title={title}
  description={description}
  keywords={keywords}
  pageTitle={pageTitle}
  pageTagline={pageTagline}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
    slot="head"
  />

  <Fragment slot="body"></Fragment>
</Page>
