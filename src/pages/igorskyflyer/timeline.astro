---
import Page from '@components/Page.astro'
import Timeline from '@components/Timeline.astro'
import { activities } from '@data/activities/timeline.ts'
import { SiteName } from '@data/site.ts'

const title = `Timeline & Technical Archive | ${SiteName}`
const description =
  'Comprehensive archive log of software engineering milestones, open-source contributions, security vulnerabilities, certifications, and project history.'
const keywords =
  'timeline, software milestones, open source, certifications, release history, igorskyflyer, igor dimitrijević'
const pageTitle = 'Engineering Timeline & Technical Archive'
const pageTagline =
  'Chronological record of software milestones, open source contributions, security advisories, and project history.'

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
  mainEntity: {
    '@type': 'Person',
    name: 'Igor Dimitrijević',
    alternateName: 'igorskyflyer',
    sameAs: [
      'https://github.com/igorskyflyer',
      'https://www.linkedin.com/in/igorskyflyer'
    ]
  }
}
---

<Page
  title={title}
  description={description}
  keywords={keywords}
  pageTitle={pageTitle}
  pageTagline={pageTagline}>
  >
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
    slot="head"
  />
  <section slot="body">
    <Timeline activities={activities} />

    <div class="photo">
      <figure>
        <img
          src="/assets/images/evolution.png"
          width="498"
          height="173"
          alt="A logo of evolution"
        />
        <br />
        <figcaption>
          <em>&ldquo;Evolution is time remembering itself.&rdquo;</em>
        </figcaption>
      </figure>
    </div>
  </section>
</Page>

<style>
  section {
    margin: auto;
    min-width: 100%;
    max-width: 100%;
  }

  .photo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-top: 3rem;
    text-align: center;
  }
</style>
