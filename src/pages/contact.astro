---
import Page from '@components/Page.astro'
import { SiteName } from '@data/site.ts'

const title: string = `Contact | ${SiteName}`
const description: string =
  'Get in touch with Igor Dimitrijević for software engineering inquiries, collaborations, or professional contact.'
const keywords =
  'contact, email, message, software engineer, full-stack, developer, igorskyflyer, igor dimitrijević'
const pageTitle = 'Contact & Inquiries'
const pageTagline =
  'Reach out for full-stack engineering, software architecture consulting, and professional collaborations.'
---

<Page
  title={title}
  description={description}
  keywords={keywords}
  pageTitle={pageTitle}
  pageTagline={pageTagline}
  featuredImage="">
  <Fragment slot="body">
    <form
      action="https://api.web3forms.com/submit"
      method="POST">
      <input
        type="hidden"
        name="access_key"
        value="d692d221-3dfb-44e6-8454-aad7563b95f7"
      />
      <input
        type="text"
        name="name"
        required
      />
      <input
        type="email"
        name="email"
        required
      />
      <textarea
        name="message"
        required
      ></textarea>
      <div
        class="h-captcha"
        data-captcha="true">
      </div>
      <button type="submit">Submit</button>
    </form>

    <script
      src="https://web3forms.com/client/script.js"
      async
      defer
    ></script>
  </Fragment>
</Page>
