---
import Page from '@components/Page.astro'
import Timeline from '@components/Timeline.astro'
import { SiteName } from '@data/site.ts'
import { activities } from '@data/timeline-activities.ts'

const pageTitle = `Timeline & Technical Archive | ${SiteName}`
const pageDescription =
  'Comprehensive archive log of software engineering milestones, open-source contributions, security vulnerabilities, certifications, and project history.'
const pageKeywords =
  'timeline, software milestones, open source, certifications, release history, igorskyflyer, igor dimitrijević'

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  mainEntity: {
    '@type': 'Person',
    name: 'Igor Dimitrijević',
    alternateName: 'igorskyflyer',
    sameAs: [
      'https://github.com/igorskyflyer',
      'https://www.linkedin.com/in/igorskyflyer'
    ]
  }
}
---

<Page
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}>
  >
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
    slot="head"
  />
  <section slot="body">
    <header class="timeline-header">
      <h4>Timeline</h4>
      <h5 class="description no-select">
        This document serves as an archive of events over the years regarding
        Igor Dimitrijević's (igorskyflyer) technical journey, education,
        open-source commitment, and contributions.
      </h5>
    </header>

    <Timeline activities={activities} />

    <div class="photo">
      <figure>
        <img
          src="/assets/images/evolution.png"
          width="498"
          height="173"
          alt="A logo of evolution"
        />
        <br />
        <figcaption>
          <em>&ldquo;Evolution is time remembering itself.&rdquo;</em>
        </figcaption>
      </figure>
    </div>
  </section>
</Page>

<style>
  header {
    margin-bottom: 2rem;
  }

  header h4 {
    margin: 0 auto 0.5rem auto;
  }

  header h5.description {
    margin-top: 2rem;
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent, #3abfc7);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.015);
    padding: 1.25rem;
    font-size: clamp(0.9rem, 0.8rem + 0.25vw, 1rem);
    line-height: 1.6;
    text-align: left;
  }

  section {
    margin: auto;
    min-width: 100%;
    max-width: 100%;
  }

  .photo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-top: 3rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    header h5.description {
      border-left: 1px solid var(--border-color);
      padding: 2.25rem;
      text-align: center;
    }
  }
</style>
