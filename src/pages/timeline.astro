---
import Page from '@components/Page.astro'
import Timeline from '@components/Timeline.astro'
import { SiteName } from '@data/site.ts'
import { activities } from '@data/timeline-activities.ts'

const pageTitle = `Timeline & Technical Archive | ${SiteName}`
const pageDescription =
  'Comprehensive archive log of software engineering milestones, open-source contributions, security vulnerabilities, certifications, and project history.'
const pageKeywords =
  'timeline, software milestones, open source, certifications, release history, igorskyflyer, igor dimitrijević'

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  mainEntity: {
    '@type': 'Person',
    name: 'Igor Dimitrijević',
    alternateName: 'igorskyflyer',
    sameAs: [
      'https://github.com/igorskyflyer',
      'https://www.linkedin.com/in/igorskyflyer'
    ]
  }
}
---

<Page
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}>
  >
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
    slot="head"
  />
  <section slot="body">
    <header class="timeline-header">
      <h4>Timeline</h4>
      <h2>Chronological Evolution</h2>
      <h4 class="description no-select">
        This document serves as an archive of events over the years regarding
        Igor Dimitrijević's (igorskyflyer) technical journey, education,
        open-source commitment, and contributions.
      </h4>
    </header>

    <Timeline activities={activities} />

    <div class="photo">
      <figure>
        <img
          src="/assets/images/evolution.png"
          width="498"
          height="173"
          alt="A logo of evolution"
        />
        <br />
        <figcaption>
          <em>&ldquo;Evolution is time remembering itself.&rdquo;</em>
        </figcaption>
      </figure>
    </div>
  </section>
</Page>

<style>
  header {
    margin-bottom: 3rem;
  }

  header h2,
  header h4 {
    margin: 0 auto 0.5rem auto;
  }

  section {
    margin: auto;
    min-width: 100%;
    max-width: 100%;
  }

  .photo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-top: 3rem;
    text-align: center;
  }

  :global(.description) {
    position: relative;
    max-width: 50%;
    text-align: center;
    padding: 2rem;
    z-index: 1;
    margin-top: 4rem !important;
    color: #ffffffbb;
  }

  :global(.description)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    border: 3px solid #0076ff44;
    background: rgba(0, 118, 255, 0.1);
    transform: skewX(0deg);
    transition: transform 90ms ease;
  }

  :global(.description):hover::before {
    transform: skewX(-15deg);
  }

  @media (max-width: 768px) {
    .description {
      max-width: 90%;
    }
  }
</style>
