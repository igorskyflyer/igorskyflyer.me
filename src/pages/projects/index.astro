---
import Page from '@components/Page.astro'
import { SiteName } from '@data/site.ts'

const title = `Projects & Developer Tools | ${SiteName}`
const description =
  'Explore software, custom DSLs, compilers, and developer tools built by Igor Dimitrijević (igorskyflyer). Lightweight, high-performance utilities.'
const keywords =
  'open source, developer tools, npm packages, custom DSLs, AST compilers, vs code extensions, typescript, javascript, igor dimitrijević, igorskyflyer'
const pageTitle = 'Projects & Work'
const pageTagline =
  'Open-source developer tools, custom software, and client solutions.'

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'Igor Dimitrijević',
    alternateName: 'igorskyflyer',
    jobTitle: 'Senior Full-Stack Software Engineer'
  }
}
---

<Page
  title={title}
  description={description}
  keywords={keywords}
  pageTitle={pageTitle}
  pageTagline={pageTagline}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
    slot="head"
  />
  <Fragment slot="body"></Fragment>
</Page>
