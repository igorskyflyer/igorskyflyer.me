---
import Page from '@components/Page.astro'
import { SiteName } from '@data/site.ts'

const title = `Privacy Policy | ${SiteName}`
const description = `Privacy policy and data handling practices for ${SiteName}. Details on cookies, analytics, user data protection, and privacy commitments.`
const keywords =
  'privacy policy, data privacy, cookies, data protection, igor dimitrijević, igorskyflyer'
const pageTitle = 'Privacy Policy & Data Protection'
const pageTagline =
  'Transparent data handling practices, security measures, and strict user privacy commitments.'

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  publisher: {
    '@type': 'Person',
    name: 'Igor Dimitrijević',
    alternateName: 'igorskyflyer'
  }
}
---

<Page
  title={title}
  description={description}
  keywords={keywords}
  pageTitle={pageTitle}
  pageTagline={pageTagline}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
    slot="head"
  />

  <section slot="body">
    <h1>Privacy Policy for <strong>igorskyflyer.me</strong></h1>

    <p>
      <strong>igorskyflyer.me</strong> does not use first-party tracking cookies or
      collect individual user telemetry.
    </p>

    <h2>Data Controller</h2>
    <p>
      This site is operated by <strong>Igor Dimitrijević</strong>. For any
      privacy query or data request, use the <a href="/contact/">contact form</a
      > or
      <a href="mailto:admin@igorskyflyer.me"><strong>email</strong></a>.
    </p>

    <h2>Data & Third-Party Services</h2>
    <p>
      Data processing is limited strictly to site functionality, security, and
      interactive features under GDPR Article 6:
    </p>

    <ul>
      <li>
        <strong>Contact Form (Web3Forms):</strong> Processes your submitted name,
        email, and message payload to deliver contact requests. <em
          >(Art. 6(1)(b))</em
        >
      </li>
      <li>
        <!-- TODO: confirm "Google" here is Google reCAPTCHA running alongside hCaptcha.
             If it's a different Google service (Fonts, Analytics, etc.), split this
             into two bullets with separate legal bases. -->
        <strong>Spam Protection (hCaptcha & Google reCAPTCHA):</strong> Analyzes browser
        characteristics and IP data on form submissions to block automated spam bots.
        <em>(Art. 6(1)(f))</em>
      </li>
      <li>
        <!-- TODO: confirm the Utterances iframe only loads after a user click,
             not automatically on page load. Automatic load is not valid Art. 6(1)(a)
             consent and needs a component fix, not just a wording fix. -->
        <strong>Comments (Utterances):</strong> Loads only after you click to view
        comments, at which point an iframe using GitHub authentication handles the
        discussion thread. <em>(Art. 6(1)(a))</em>
      </li>
      <li>
        <strong>Performance (Cloudflare Analytics):</strong> Aggregates page load
        metrics without user tracking or persistent cookies. <em
          >(Art. 6(1)(f))</em
        >
      </li>
    </ul>

    <h2>Retention</h2>
    <p>
      Contact form submissions are retained for <strong>[X months/years]</strong
      > and then deleted. Server access logs are retained for <strong
        >[X days]</strong
      > before automatic rotation or deletion. Comment data (Utterances) is retained
      per GitHub's own retention policy, since discussions are stored as GitHub issues
      on <strong>[repo name]</strong>, not on this site's infrastructure.
    </p>

    <h2>International Transfers</h2>
    <p>
      Some third-party services listed above (hCaptcha, Google, Cloudflare,
      GitHub/Utterances) may process data outside the European Economic Area.
      Where this occurs, transfers rely on the provider's Standard Contractual
      Clauses or an applicable adequacy decision. See each provider's own
      privacy policy for details: <a
        href="https://www.hcaptcha.com/privacy"
        target="_blank"
        >hCaptcha</a
      >
    </p>, <a
      href="https://policies.google.com/privacy"
      target="_blank"
      >Google</a
    >,
    <a
      href="https://www.cloudflare.com/privacypolicy/"
      target="_blank"
      >Cloudflare</a
    >,
    <a
      href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement"
      target="_blank"
      >GitHub
    </a>.
  </section>

  <h2>Server Logs</h2>
  <p>
    Standard access logs temporarily process visitor IP addresses and user
    agents strictly for network diagnostics and infrastructure security. <em
      >(Art. 6(1)(f))</em
    >
  </p>

  <h2>Your Rights</h2>
  <p>
    Under the GDPR, you have the right to access, rectify, export, or request
    deletion of any personal data submitted via the site. Direct any privacy
    queries or data requests to <strong>Igor Dimitrijević</strong> through the
    <a
      href="/contact/"
      target="_blank"
      ><strong>contact form</strong></a
    >.
  </p>
  <p>
    You also have the right to lodge a complaint with a supervisory authority,
    in particular in the EU member state of your habitual residence, place of
    work, or place of the alleged infringement.
  </p>

  <p>Last updated: <code>2026-08-09</code></p>
</Page>
