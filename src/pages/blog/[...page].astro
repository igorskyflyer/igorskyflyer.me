---
import Page from '@components/Page.astro'
import PostsDisplay from '@components/PostsDisplay.astro'
import { PostsPerPage, SiteName } from '@data/site.ts'
import type { Page as BlogPage, GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'

export interface Props {
  page: BlogPage
}

const { page } = Astro.props

const pageTitle =
  page.currentPage > 1
    ? `Blog - Page ${page.currentPage} | ${SiteName}`
    : `Blog | ${SiteName}`

const description =
  'Read technical articles, software engineering insights, tutorials, and development updates written by Igor Dimitrijević (igorskyflyer).'
const keywords =
  'software engineering, web development, full-stack, blog, programming, JavaScript, TypeScript, Astro, technical articles, igor dimitrijević, igorskyflyer'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection('blog')

  const activePosts = posts
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())

  return paginate(activePosts, { pageSize: PostsPerPage })
}
---

<Page
  title={pageTitle}
  description={description}
  keywords={keywords}
  featuredImage="">
  <div
    class="archive-container"
    slot="body">
    <header class="archive-header">
      <h1 class="archive-title">Technical Articles</h1>
      <p class="archive-subtitle">
        Software engineering, web architectures, and performance development.
      </p>
      {
        page.lastPage > 1 && (
          <p class="page-badge">
            Page {page.currentPage} of {page.lastPage}
          </p>
        )
      }
    </header>

    <section class="posts-section">
      <PostsDisplay posts={page.data} />
    </section>

    {
      page.lastPage > 1 && (
        <nav
          class="pagination"
          role="navigation"
          aria-label="Pagination">
          <div class="pagination-slot">
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class="pagination-btn"
                aria-label="Previous page">
                <span aria-hidden="true">&larr;</span> Previous
              </a>
            ) : (
              <span
                class="pagination-btn disabled"
                aria-disabled="true">
                <span aria-hidden="true">&larr;</span> Previous
              </span>
            )}
          </div>

          <span class="pagination-status">
            {page.currentPage} / {page.lastPage}
          </span>

          <div class="pagination-slot right">
            {page.url.next ? (
              <a
                href={page.url.next}
                class="pagination-btn"
                aria-label="Next page">
                Next <span aria-hidden="true">&rarr;</span>
              </a>
            ) : (
              <span
                class="pagination-btn disabled"
                aria-disabled="true">
                Next <span aria-hidden="true">&rarr;</span>
              </span>
            )}
          </div>
        </nav>
      )
    }
  </div>
</Page>

<style>
  .archive-container {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
    box-sizing: border-box;
    margin: 0 auto;
    padding: clamp(1rem, 4vw, 2rem) 0;
    width: 100%;
    max-width: 900px;
  }

  .archive-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 0.85rem);
    text-align: center;
  }

  .archive-title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .archive-subtitle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    max-width: 65ch;
    color: #94a3b8;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    line-height: 1.5;
  }

  .page-badge {
    display: inline-flex;
    align-items: center;
    margin: 1rem auto 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.15rem 0.65rem;
    color: var(--link, #0ea8ff);
    font-weight: 600;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .posts-section {
    width: 100%;
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    width: 100%;
  }

  .pagination-slot {
    display: flex;
    flex: 1;
  }

  .pagination-slot.right {
    justify-content: flex-end;
  }

  .pagination-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius, 8px);
    background: rgba(255, 255, 255, 0.03);
    padding: clamp(0.4rem, 1.5vw, 0.6rem) clamp(0.85rem, 2.5vw, 1.25rem);
    color: #f8fafc;
    font-weight: 500;
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    text-decoration: none;
  }

  .pagination-btn:not(.disabled):hover {
    transform: translateY(-1px);
    border-color: var(--link, #0ea8ff);
    background: rgba(14, 168, 255, 0.1);
    color: var(--link, #0ea8ff);
  }

  .pagination-btn.disabled {
    opacity: 0.35;
    cursor: not-allowed;
    border-color: rgba(255, 255, 255, 0.05);
  }

  .pagination-status {
    color: #64748b;
    font-weight: 600;
    font-size: clamp(0.8rem, 1.5vw, 0.9rem);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .pagination-btn {
      padding: 0.4rem 0.75rem;
    }
  }
</style>
