---
import { SiteName } from '@data/site.ts'
import Page from '@components/Page.astro'
import SafeResource from '@igor.dvlpr/astro-saferesource'
---

<Page title={`404: Page Not Found | ${SiteName}`}>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <section class="not-found-wrapper" slot="body">
    <div class="not-found-card">
      <div class="illustration-container">
        <img
          src="/assets/images/404.png"
          alt="404 Illustration"
          class="illustration"
          fetchpriority="high"
          loading="eager"
          width="360"
          height="240"
        />
      </div>

      <div class="status-badge">
        <span class="status-dot"></span>
        <code>HTTP 404: NOT_FOUND</code>
      </div>

      <h1 class="title">Destination Void</h1>
      <p class="description">
        The route you are trying to access does not exist, was renamed, or has
        been purged from cache.
      </p>

      <div class="actions">
        <a href="/" class="btn btn-primary"> Back to Home </a>
        <button
          type="button"
          onclick="history.back()"
          disabled="true"
          class="btn btn-secondary"
          id="btn-back">
          Previous Page
        </button>
      </div>
    </div>
  </section>
  <SafeResource>
    <script>
      const btnBack = document.querySelector<HTMLButtonElement>('btn-back')

      if (btnBack && window.history.length > 1) {
        btnBack.disabled = false
      }
    </script>
  </SafeResource>
</Page>

<style>
  .not-found-wrapper {
    display: flex;
    position: relative;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    padding: 0 1rem;
    overflow: hidden;
  }

  .not-found-wrapper::before,
  .not-found-wrapper::after {
    position: absolute;
    will-change: opacity, transform;
    inset: 0;
    pointer-events: none;
    content: '';
  }

  .not-found-wrapper::before {
    animation: pulseStar 4s ease-in-out 16 alternate;
    background-image:
      radial-gradient(3px 3px at 25px 30px, #ffffff, transparent),
      radial-gradient(
        5px 5px at 150px 80px,
        rgba(255, 255, 255, 0.9),
        transparent
      ),
      radial-gradient(
        2px 2px at 280px 120px,
        rgba(255, 255, 255, 0.6),
        transparent
      ),
      radial-gradient(6px 6px at 400px 200px, #ffffff, transparent),
      radial-gradient(
        2px 2px at 500px 50px,
        rgba(255, 255, 255, 0.5),
        transparent
      ),
      radial-gradient(
        4px 4px at 650px 300px,
        rgba(255, 255, 255, 0.8),
        transparent
      ),
      radial-gradient(
        3px 3px at 720px 180px,
        rgba(255, 255, 255, 0.7),
        transparent
      );
    background-size: 500px 500px;
  }

  .not-found-wrapper::after {
    animation: pulseStar 7s ease-in-out 16 alternate-reverse;
    background-image:
      radial-gradient(
        2px 2px at 80px 140px,
        rgba(255, 255, 255, 0.7),
        transparent
      ),
      radial-gradient(4px 4px at 220px 290px, #ffffff, transparent),
      radial-gradient(
        6px 6px at 340px 60px,
        rgba(255, 255, 255, 0.9),
        transparent
      ),
      radial-gradient(
        3px 3px at 450px 380px,
        rgba(255, 255, 255, 0.6),
        transparent
      ),
      radial-gradient(
        5px 5px at 600px 120px,
        rgba(255, 255, 255, 0.8),
        transparent
      );
    background-size: 600px 600px;
  }

  @keyframes pulseStar {
    0% {
      transform: scale(0.85);
      opacity: 0.15;
    }
    100% {
      transform: scale(1.15);
      opacity: 1;
    }
  }

  .illustration {
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.5));
    animation: float 6s ease-in-out 16;
    will-change: transform;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate3d(0px, 0px, 0px) rotate(0deg);
    }
    33% {
      transform: translate3d(-15px, -24px, 0px) rotate(-4deg);
    }
    66% {
      transform: translate3d(12px, -10px, 0px) rotate(3deg);
    }
  }

  .not-found-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    backdrop-filter: blur(12px);
    padding: 3rem 2rem;
    width: 100%;
    text-align: center;
  }

  .illustration-container {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
    width: 100%;
    max-width: 360px;
  }

  .illustration {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 2rem;
    background: rgba(239, 68, 68, 0.1);
    padding: 0.35rem 0.85rem;
    color: #f87171;
    font-size: 0.825rem;
  }

  .status-dot {
    box-shadow: 0 0 8px #ef4444;
    border-radius: 50%;
    background-color: #ef4444;
    width: 8px;
    height: 8px;
  }

  .title {
    margin: 0 0 0.75rem 0;
    color: #f8fafc;
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.025em;
  }

  .description {
    margin: 0 0 2rem 0;
    max-width: 440px;
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    transition: all 180ms ease;
    cursor: pointer;
    border: none;
    border-radius: 0.75rem;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    font-size: 0.925rem;
    text-decoration: none;
  }

  .btn-primary {
    box-shadow: 0 4px 14px rgba(0, 47, 156, 0.35);
    background: var(--primary, #002f9c);
    color: #ffffff;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 47, 156, 0.5);
    background: #003ebd;
  }

  .btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  #btn-back:disabled {
    cursor: not-allowed;
  }

  @media (max-width: 480px) {
    .not-found-card {
      padding: 2rem 1.25rem;
    }

    .actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
