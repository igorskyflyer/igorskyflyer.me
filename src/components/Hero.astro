---
import { Icon } from 'astro-icon/components'
---

<section
  id="hero"
  class="reveal">
  <div id="hero-name">
    <span
      id="hero-intro"
      data-nosnippet>
      Hi, I am
    </span>
    <h1>Igor Dimitrijević</h1>
    <p id="hero-description">
      Senior full-stack software engineer, freelance developer, and a DX
      specialist, known online as
      <strong>igorskyflyer</strong>. Author of an open-source DSL, compiler, and
      an ecosystem of npm packages. BSc (Hons) in IT & Software Engineering.
    </p>
    <br />
    <div id="group-cta">
      <a
        class="btn-cta btn-primary"
        href="#work"
        >View my Work</a
      >
      <a
        class="btn-cta btn-secondary"
        href="#blog"
        >View my Blog</a
      >
    </div>
    <div id="hero-social">
      <a
        href="https://github.com/igorskyflyer"
        rel="external noopener noreferrer"
        target="_blank"
        aria-label="igorskyflyer's GitHub profile"
        title="igorskyflyer's GitHub profile"
        class="social-icon-link social-github">
        <Icon
          name="mdi:github"
          class="social-icon"
        />
      </a>
      <a
        href="https://www.linkedin.com/in/igorskyflyer/"
        rel="external noopener noreferrer"
        target="_blank"
        aria-label="igorskyflyer's LinkedIn profile"
        title="igorskyflyer's LinkedIn profile"
        class="social-icon-link social-linkedin">
        <Icon
          name="mdi:linkedin"
          class="social-icon"
        />
      </a>
      <a
        href="https://npmjs.com/~igorskyflyer"
        rel="external noopener noreferrer"
        target="_blank"
        aria-label="igorskyflyer's npm profile"
        title="igorskyflyer's npm profile"
        class="social-icon-link social-npm">
        <Icon
          name="mdi:npm"
          class="social-icon"
        />
      </a>
      <a
        href="mailto:connect@igorskyflyer.me"
        rel="external noopener noreferrer"
        target="_blank"
        aria-label="Contact igorskyflyer via email"
        title="Contact igorskyflyer via email"
        class="social-icon-link social-email">
        <Icon
          name="mdi:email"
          class="social-icon"
        />
      </a>
    </div>
  </div>
  <div id="hero-photo">
    <figure class="photo-wrapper no-interactivity">
      <img
        alt="A photo of Igor Dimitrijević (igorskyflyer), a freelance senior full-stack software engineer."
        loading="eager"
        fetchpriority="high"
        src="/assets/author/igorskyflyer.webp"
        width="350"
        height="350"
      />
    </figure>
    <div
      id="hire-status"
      class="no-select">
      <span id="hire-availability">Available for Hire</span>
    </div>
  </div>
</section>

<style>
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.1;
    }
  }

  #hero {
    display: flex;
    position: relative;
    flex-direction: column-reverse;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin: auto;
    padding-top: 1.5rem;
    width: 90%;
  }

  #hero::before {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: -1;
    filter: blur(40px);
    background: radial-gradient(
      ellipse at center,
      rgba(14, 168, 255, 0.12) 0%,
      rgba(0, 47, 156, 0.08) 45%,
      transparent 70%
    );
    width: 100%;
    max-width: 600px;
    height: 100%;
    max-height: 400px;
    pointer-events: none;
    content: '';
  }

  #hero-name {
    width: 100%;
    text-align: center;
  }

  #hero-photo {
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    max-width: 500px;
    text-align: center;
  }

  #hire-status {
    display: inline-flex;
    position: relative;
    justify-content: center;
    align-items: center;
    gap: 8px;
    z-index: 2;
    backdrop-filter: blur(8px);
    margin-top: -3rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--btn-radius);
    background: rgba(13, 17, 23, 0.85);
    padding: 0.5rem 0.85rem;
    width: auto;
    max-width: 100%;
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    background: rgba(0, 128, 266, 0.3);
    pointer-events: auto;
    color: #e2e8f0;
    font-size: 0.8rem;
  }

  #hire-availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  #hire-availability::before {
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
    box-shadow: 0 0 8px #1fe066;
    border-radius: 50%;
    background: #1fe066;
    width: 8px;
    height: 8px;
    content: '';
  }

  #hero-name h1 {
    margin: 0 0 0.5rem 0;
    font-size: 2.25rem;
    line-height: 1.1;
  }

  #hero-photo .photo-wrapper {
    display: flex;
    position: relative;
    justify-content: center;
    align-items: center;
    margin: 0;
    border-radius: var(--radius, 8px);
    overflow: hidden;
  }

  #hero-photo .photo-wrapper img {
    display: block;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  #hero-intro {
    opacity: 0.4;
    font-size: 0.85rem;
  }

  #hero-description {
    opacity: 0.8;
    line-height: 1.5;
  }

  #group-cta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  @media screen and (min-width: 1024px) {
    #hire-status {
      margin-top: -3rem;
    }

    #hero-name h1 {
      font-size: 4rem;
    }
  }

  @media screen and (max-width: 768px) {
    #hero {
      width: 100%;
    }

    #hero-photo {
      max-width: 350px;
    }
  }

  @media screen and (min-width: 768px) {
    #hero {
      flex-direction: row;
      gap: 2rem;
    }

    #hero-name {
      text-align: left;
    }

    #hero-photo {
      position: relative;
    }

    #hero-name h1 {
      font-size: 3.5rem;
    }

    #group-cta {
      flex-direction: row;
      width: auto;
    }

    #hire-status {
      position: absolute;
      bottom: 0.75rem;
      left: 50%;
      transform: translateX(-50%);
      margin-top: 0;
    }
  }

  #hero-social {
    display: inline-flex;
    gap: 24px;
    margin-top: 2rem;
  }

  .social-icon-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    width: 48px;
    height: 48px;
    color: #94a3b8;
  }

  .social-icon-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 16px rgba(14, 168, 255, 0.25);
    color: #fff;
  }

  .social-icon {
    width: 32px;
    height: 32px;
  }

  .social-github:hover {
    border-color: #6a737d;
    background-color: #24292e;
  }

  .social-linkedin:hover {
    border-color: #70b5ff;
    background-color: #0a66c2;
  }

  .social-npm:hover {
    border-color: #ff8b8a;
    background-color: #cb3837;
  }

  .social-email:hover {
    border-color: #ffb380;
    background-color: #ff6600;
  }
</style>
