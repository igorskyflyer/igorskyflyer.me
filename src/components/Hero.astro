---
import SocialIcon from '@components/SocialIcon.astro'
---

<section id="hero" class="reveal">
  <div id="hero-name">
    <span id="hero-intro" data-nosnippet> Hi, I am </span>
    <h1>Igor Dimitrijević</h1>
    <p id="hero-description">
      Senior full-stack software engineer and freelance architect known as <strong
        >igorskyflyer</strong
      >. I help businesses build high-performance websites, applications, and
      software systems, backed by an open-source footprint of custom compilers,
      AST engines, and developer tooling.
    </p>
    <br />
    <div id="group-cta">
      <a class="btn-cta btn-primary" href="/contact/">Hire me</a>
      <a class="btn-cta btn-secondary" href="#work">View my Work</a>
    </div>
    <div id="hero-social">
      <SocialIcon
        href="https://github.com/igorskyflyer"
        label="igorskyflyer's GitHub profile"
        variant="github"
      />
      <SocialIcon
        href="https://www.linkedin.com/in/igorskyflyer/"
        label="igorskyflyer's LinkedIn profile"
        variant="linkedin"
      />
      <SocialIcon
        href="https://npmjs.com/~igorskyflyer"
        label="igorskyflyer's npm profile"
        variant="npm"
      />
      <SocialIcon
        href="mailto:connect@igorskyflyer.me"
        label="Contact igorskyflyer via email"
        variant="email"
        inbound={true}
      />
    </div>
  </div>
  <div id="hero-photo">
    <figure class="photo-wrapper no-interactivity">
      <img
        alt="A photo of Igor Dimitrijević (igorskyflyer), a freelance senior full-stack software engineer."
        loading="eager"
        fetchpriority="high"
        src="/assets/author/igorskyflyer.webp"
        width="350"
        height="350"
      />
    </figure>
    <div id="hire-status" class="no-select">
      <span id="hire-availability">Available for Hire</span>
    </div>
  </div>
</section>

<style>
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.1;
    }
  }

  #hero {
    display: flex;
    position: relative;
    flex-direction: column-reverse;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin: auto;
    width: 90%;
  }

  #hero::before {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: -1;
    filter: blur(40px);
    background: radial-gradient(
      ellipse at center,
      rgba(14, 168, 255, 0.12) 0%,
      rgba(0, 47, 156, 0.08) 45%,
      transparent 70%
    );
    width: 100%;
    max-width: 600px;
    height: 100%;
    max-height: 400px;
    pointer-events: none;
    content: '';
  }

  #hero-name {
    width: 100%;
    text-align: center;
  }

  #hero-photo {
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    max-width: 500px;
    text-align: center;
  }

  #hire-status {
    display: inline-flex;
    position: relative;
    justify-content: center;
    align-items: center;
    gap: 8px;
    z-index: 2;
    backdrop-filter: blur(8px);
    margin-top: -3rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--btn-radius);
    background: rgba(13, 17, 23, 0.85);
    padding: 0.5rem 0.85rem;
    width: auto;
    max-width: 100%;
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    background: rgba(0, 128, 266, 0.3);
    pointer-events: auto;
    font-size: 0.8rem;
  }

  #hire-availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  #hire-availability::before {
    flex-shrink: 0;
    animation: pulse 2s ease-in-out 16;
    box-shadow: 0 0 8px #1fe066;
    border-radius: 50%;
    background: #1fe066;
    width: 8px;
    height: 8px;
    content: '';
  }

  #hero-name h1 {
    margin: 0 0 0.5rem 0;
    font-size: 2.25rem;
    line-height: 1.1;
  }

  #hero-photo .photo-wrapper {
    display: flex;
    position: relative;
    justify-content: center;
    align-items: center;
    margin: 0;
    border-radius: var(--radius, 8px);
    overflow: hidden;
  }

  #hero-photo .photo-wrapper img {
    display: block;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  #hero-intro {
    opacity: 0.4;
    font-size: 1rem;
  }

  #hero-description {
    opacity: 0.8;
    margin: 0.5rem auto 0 auto;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  #group-cta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  @media screen and (min-width: 1024px) {
    #hero {
      padding-top: 1.5rem;
    }

    #hire-status {
      margin-top: -3rem;
    }

    #hero-name h1 {
      margin-bottom: 1rem;
      font-size: 4rem;
    }
  }

  @media screen and (max-width: 768px) {
    #hero-intro {
      font-size: 0.85rem;
    }

    #hero-name h1 {
      font-size: 2rem;
    }

    #hero-description {
      font-size: 0.95rem;
    }

    #hero {
      width: 100%;
    }

    #hero-photo {
      max-width: 350px;
    }
  }

  @media screen and (min-width: 768px) {
    #hero {
      flex-direction: row;
      gap: 2rem;
    }

    #hero-name {
      text-align: left;
    }

    #hero-photo {
      position: relative;
    }

    #group-cta {
      flex-direction: row;
      width: auto;
    }

    #hire-status {
      position: absolute;
      bottom: 0.75rem;
      left: 50%;
      transform: translateX(-50%);
      margin-top: 0;
    }
  }

  #hero-social {
    display: inline-flex;
    gap: 24px;
    margin-top: 2rem;
  }
</style>
