---
import { IDecadeBlock } from '@interfaces/activities/IDecadeBlock.ts'
import { CategoryBadge } from '@my-types/activities/CategoryBadge.ts'
import '@ui/timeline-badges.css'

export interface Props {
  activities: IDecadeBlock[]
}

const { activities = [] } = Astro.props
---

<section class="timeline-wrapper">
  <div class="decades-list">
    {
      activities.map((decadeGroup) => (
        <details
          class="decade-card"
          open={decadeGroup.open}>
          <summary class="decade-summary">
            <span class="decade-title">
              <span class="decade-icon">{decadeGroup.icon}</span>
              <strong>{decadeGroup.decade}</strong>
            </span>
            <span class="decade-count">
              {decadeGroup.years.reduce((acc, y) => acc + y.entries.length, 0)}{' '}
              events
            </span>
          </summary>

          <div class="decade-body">
            {decadeGroup.years.map((yearGroup, yearIndex) => (
              <div class="year-section">
                <div
                  class="year-header"
                  id={yearGroup.year.toString()}>
                  <code>{yearGroup.year}</code>
                </div>

                <div class="timeline-spine">
                  {yearGroup.entries.map((entry) => (
                    <article class="timeline-node">
                      <div class="node-marker" />

                      <div class="node-meta">
                        <span
                          class={`badge ${CategoryBadge[entry.category].class}`}>
                          {CategoryBadge[entry.category].label}
                        </span>
                        <time>{entry.date}</time>
                      </div>

                      <div
                        class="timeline-entry"
                        set:html={entry.html}
                      />
                    </article>
                  ))}
                </div>
                {yearIndex < decadeGroup.years.length - 1 && (
                  <div
                    class="separator"
                    aria-hidden="true"
                  />
                )}
              </div>
            ))}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .timeline-wrapper {
    margin: 0 auto;
    max-width: 100%;
  }

  .timeline-header {
    margin-bottom: 2rem;
  }

  .timeline-header h4 {
    margin: 0 0 0.25rem 0;
    color: #64748b;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline-header h2 {
    margin: 0 0 0.5rem 0;
    color: #f8fafc;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .timeline-quote {
    margin: 0;
    color: #94a3b8;
    font-style: italic;
    font-size: 0.9rem;
  }

  .decades-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .decade-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius, 8px);
    background: #07121f;
  }

  .decade-card[open] {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .decade-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background-color 90ms ease;
    cursor: pointer;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.85rem 1.25rem;
    list-style: none;
    user-select: none;
  }

  .decade-card[open] .decade-summary {
    border-color: rgba(255, 255, 255, 0.1);
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
  }

  .decade-summary::-webkit-details-marker {
    display: none;
  }

  .decade-summary:hover {
    background-color: #3780edaa;
  }

  .decade-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #f1f5f9;
    font-size: 1.15rem;
  }

  .decade-count {
    border: 2px solid #ffffff55;
    border-radius: 9999px;
    padding: 0.15rem 0.6rem;
    color: #ffffff;
    font-size: 0.75rem;
  }

  .decade-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.5rem;
  }

  .year-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .year-header {
    position: sticky;
    top: 0;
    z-index: 1;
    backdrop-filter: blur(8px);
    margin: 0;
    padding: 0.5rem 0;
  }

  @media screen and (min-width: 1024px) {
    .year-header {
      top: var(--header-height, 64px);
    }
  }

  .year-header code {
    border: 1px solid rgba(14, 168, 255, 0.2);
    border-radius: 4px;
    background: rgba(14, 168, 255, 0.08);
    padding: 0.2rem 0.6rem;
    color: var(--link, #0ea8ff);
    font-weight: 700;
    font-size: clamp(1.8rem, 1.8rem + 0.25vw, 2.5rem);
  }

  .timeline-spine {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 1.25rem;
    margin-left: 0.75rem;
    border-left: 2px solid rgba(255, 255, 255, 0.1);
    padding-left: 1.5rem;
  }

  .timeline-node {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .node-marker {
    position: absolute;
    top: 0.35rem;
    left: -1.85rem;
    box-shadow: 0 0 6px var(--link, #0ea8ff);
    border: 2px solid #0f172a;
    border-radius: 50%;
    background: var(--link, #0ea8ff);
    width: 10px;
    height: 10px;
  }

  .node-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .node-meta time {
    color: #64748b;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
  }

  .node-title {
    margin: 0;
    color: #f1f5f9;
    font-weight: 400;
    font-size: 0.925rem;
    line-height: 1.45;
  }

  .timeline-entry {
    font-size: clamp(1rem, 0.75rem + 0.25vw, 2rem);
    line-height: 2;
    overflow-wrap: break-word;
  }

  .timeline-entry :global(code) {
    box-decoration-break: clone;
    border-radius: var(--radius);
    background: #00aaff33;
    padding: 0.15rem 0.3rem;
    font-weight: bold;
    font-size: clamp(0.75em, 0.75em + 0.25vw, 1em);
    white-space: nowrap;
    -webkit-box-decoration-break: clone;
  }

  .timeline-entry :global(a),
  .timeline-entry :global(a:visited) {
    transition:
      background 100ms ease-in-out,
      border-color 100ms ease-in-out,
      box-shadow 100ms ease-in-out;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(14, 168, 255, 0.3);
    border-radius: var(--radius);
    background: rgba(14, 168, 255, 0.12);
    padding: 0.15rem 0.3rem;
    color: var(--link);
    font-weight: bold;
    font-size: clamp(0.85em, 0.85em + 0.25vw, 1.2em);
    white-space: nowrap;
  }

  .timeline-entry :global(a):hover {
    box-shadow: 0 6px 12px rgba(14, 168, 255, 0.2);
    border-color: rgba(14, 168, 255, 0.6);
    background: rgba(14, 168, 255, 0.25);
  }

  .separator {
    margin: 2rem auto;
    background: linear-gradient(to right, transparent, #0e87ffaa, transparent);
    width: 90%;
    height: 1px;
  }

  @media (max-width: 640px) {
    .decade-body {
      padding: 1rem;
    }

    .timeline-spine {
      margin-left: 0.25rem;
      padding-left: 1.15rem;
    }

    .node-marker {
      left: -1.5rem;
    }
  }
</style>
