---
type ActivityCategory =
  'cert' | 'entity' | 'general' | 'git' | 'media' | 'npm' | 'pr' | 'release'

interface TimelineEntry {
  category: ActivityCategory
  date: string
  html: string
}

interface YearBlock {
  year: string
  entries: TimelineEntry[]
}

export interface DecadeBlock {
  decade: string
  icon: string
  open?: boolean
  years: YearBlock[]
}

const categoryBadges: Record<
  ActivityCategory,
  { label: string; class: string }
> = {
  cert: { label: 'Certification', class: 'badge-cert' },
  entity: { label: 'Verified', class: 'badge-entity' },
  general: { label: 'Milestone', class: 'badge-general' },
  git: { label: 'GitHub', class: 'badge-git' },
  media: { label: 'Media', class: 'badge-media' },
  npm: { label: 'npm', class: 'badge-npm' },
  pr: { label: 'Contribution', class: 'badge-pr' },
  release: { label: 'Release', class: 'badge-release' }
}

export interface Props {
  data: DecadeBlock[]
}

const { data = [] } = Astro.props
---

<section class="timeline-wrapper">
  <div class="decades-list">
    {
      data.map((decadeGroup) => (
        <details
          class="decade-card"
          open={decadeGroup.open}>
          <summary class="decade-summary">
            <span class="decade-title">
              <span class="decade-icon">{decadeGroup.icon}</span>
              <strong>{decadeGroup.decade}</strong>
            </span>
            <span class="decade-count">
              {decadeGroup.years.reduce((acc, y) => acc + y.entries.length, 0)}{' '}
              events
            </span>
          </summary>

          <div class="decade-body">
            {decadeGroup.years.map((yearGroup) => (
              <div class="year-section">
                <div class="year-header">
                  <code>{yearGroup.year}</code>
                </div>

                <div class="timeline-spine">
                  {yearGroup.entries.map((entry) => (
                    <article class="timeline-node">
                      <div class="node-marker" />

                      <div class="node-meta">
                        <span
                          class={`badge ${categoryBadges[entry.category].class}`}>
                          {categoryBadges[entry.category].label}
                        </span>
                        <time>{entry.date}</time>
                      </div>

                      <div
                        class="timeline-entry"
                        set:html={entry.html}
                      />
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .timeline-wrapper {
    margin: 0 auto;
    max-width: 100%;
  }

  .timeline-header {
    margin-bottom: 2rem;
  }

  .timeline-header h4 {
    margin: 0 0 0.25rem 0;
    color: #64748b;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline-header h2 {
    margin: 0 0 0.5rem 0;
    color: #f8fafc;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .timeline-quote {
    margin: 0;
    color: #94a3b8;
    font-style: italic;
    font-size: 0.9rem;
  }

  .decades-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .decade-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius, 8px);
    background: rgba(0, 0, 0, 0.2);
  }

  .decade-card[open] {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .decade-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    border-top-right-radius: calc(var(--radius, 8px) - 1px);
    border-top-left-radius: calc(var(--radius, 8px) - 1px);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.85rem 1.25rem;
    list-style: none;
    user-select: none;
  }

  .decade-summary::-webkit-details-marker {
    display: none;
  }

  .decade-summary:hover {
    background: rgba(46, 108, 253, 0.1);
  }

  .decade-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #f1f5f9;
    font-size: 1.15rem;
  }

  .decade-count {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 0.15rem 0.6rem;
    color: #64748b;
    font-size: 0.75rem;
  }

  .decade-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.5rem;
  }

  .year-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .year-header {
    position: sticky;
    top: 0;
    z-index: 1;
    backdrop-filter: blur(8px);
    margin: 0;
    padding: 0.5rem 0;
  }

  @media screen and (min-width: 1024px) {
    .year-header {
      top: var(--header-height, 64px);
    }
  }

  .year-header code {
    border: 1px solid rgba(14, 168, 255, 0.2);
    border-radius: 4px;
    background: rgba(14, 168, 255, 0.08);
    padding: 0.2rem 0.6rem;
    color: var(--link, #0ea8ff);
    font-weight: 700;
    font-size: 1.4rem;
  }

  .timeline-spine {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 1.25rem;
    margin-left: 0.75rem;
    border-left: 2px solid rgba(255, 255, 255, 0.1);
    padding-left: 1.5rem;
  }

  .timeline-node {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 0.35rem;
  }

  .node-marker {
    position: absolute;
    top: 0.35rem;
    left: -1.85rem;
    box-shadow: 0 0 6px var(--link, #0ea8ff);
    border: 2px solid #0f172a;
    border-radius: 50%;
    background: var(--link, #0ea8ff);
    width: 10px;
    height: 10px;
  }

  .node-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .node-meta time {
    color: #64748b;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
  }

  .badge {
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .badge-cert {
    border: 1px solid rgba(234, 179, 8, 0.3);
    background: rgba(234, 179, 8, 0.4);
    color: #facc15;
  }
  .badge-entity {
    border: 1px solid rgba(168, 85, 247, 0.3);
    background: rgba(168, 85, 247, 0.4);
    color: #c084fc;
  }
  .badge-general {
    border: 1px solid rgba(148, 163, 184, 0.3);
    background: rgba(255, 33, 115, 0.3);
    color: #cbd5e1;
  }
  .badge-git {
    border: 1px solid rgba(59, 130, 246, 0.3);
    background: rgba(59, 130, 246, 0.4);
    color: #60a5fa;
  }
  .badge-media {
    border: 1px solid rgba(236, 72, 153, 0.3);
    background: rgba(236, 72, 153, 0.4);
    color: #f472b6;
  }
  .badge-npm {
    border: 1px solid rgba(239, 68, 68, 0.3);
    background: rgba(239, 68, 68, 0.4);
    color: #f87171;
  }
  .badge-pr {
    border: 1px solid rgba(34, 197, 94, 0.3);
    background: rgba(34, 197, 94, 0.4);
    color: #4ade80;
  }
  .badge-release {
    border: 1px solid rgba(14, 168, 255, 0.3);
    background: rgba(14, 168, 255, 0.4);
    color: #38bdf8;
  }

  .node-title {
    margin: 0;
    color: #f1f5f9;
    font-weight: 400;
    font-size: 0.925rem;
    line-height: 1.45;
  }

  .node-link {
    margin-left: 0.4rem;
    color: var(--link, #0ea8ff);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .node-link:hover {
    text-decoration: underline;
  }

  .timeline-entry {
    line-height: 2;
  }

  .timeline-entry :global(code) {
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(14, 168, 255, 0.3);
    border-radius: 6px;
    background: rgba(14, 168, 255, 0.12);
    padding: 0.2rem 0.5rem;
    color: var(--link, #0ea8ff);
    font-size: 1rem;
    white-space: nowrap;
  }

  .timeline-entry :global(a),
  .timeline-entry :global(a:visited) {
    color: var(--link);
    font-weight: bold;
  }

  @media (max-width: 640px) {
    .decade-body {
      padding: 1rem;
    }

    .timeline-spine {
      margin-left: 0.25rem;
      padding-left: 1.15rem;
    }

    .node-marker {
      left: -1.5rem;
    }
  }
</style>
