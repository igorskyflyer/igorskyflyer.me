---
import Brand from './Brand.astro'
---

<header>
  <Brand />
  <nav
    id="menu-navigation"
    role="navigation"
    aria-label="Site's menu">
    <button
      id="hamburger-icon"
      type="button"
      popovertarget="menu-dialog"
      aria-label="Toggle navigation menu">
      <svg
        viewBox="0 0 10 8"
        width="36"
        height="36">
        <path
          d="M1 1h8M3 4h6M1 7h8"
          stroke="#fff"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <div
      id="menu-dialog"
      popover="auto">
      <button
        id="menu-close"
        type="button"
        popovertarget="menu-dialog"
        popovertargetaction="hide"
        aria-label="Close navigation menu">
        <svg
          viewBox="0 0 16 16"
          width="20"
          height="20">
          <path
            d="M1 1l14 14M15 1L1 15"
            stroke="#fff"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
      <ul id="menu">
        <li><a href="/#">Home</a></li>
        <li><a href="/blog/#">Blog</a></li>
        <li><a href="/portfolio/#">Portfolio</a></li>
        <li>
          <a
            href="https://github.com/igorskyflyer"
            target="_blank"
            rel="noopener noreferrer"
            >GitHub</a
          >
        </li>
        <li><a href="/contact/#">Contact</a></li>
        <li>
          <a
            href="https://ko-fi.com/igorskyflyer"
            target="_blank"
            rel="noopener noreferrer"
            >Support me</a
          >
        </li>
      </ul>
    </div>
  </nav>
  <div>
    <a
      href="#connect"
      class="btn-cta btn-primary"
      >Get in Touch</a
    >
  </div>
</header>
