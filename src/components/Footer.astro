---
import SocialIcon from '@components/SocialIcon.astro'
import { getYear } from '@functions/utilities.ts'
---

<footer class="site-footer">
  <div class="footer-container">
    <nav
      class="social-nav"
      aria-label="Social Links">
      <SocialIcon
        href="https://github.com/igorskyflyer"
        label="igorskyflyer's GitHub profile"
        variant="github"
        size="clamp"
      />
      <SocialIcon
        href="https://youtube.com/@igorskyflyer"
        label="igorskyflyer's YouTube channel"
        variant="youtube"
        size="clamp"
      />
      <SocialIcon
        href="https://www.linkedin.com/in/igorskyflyer/"
        label="igorskyflyer's LinkedIn profile"
        variant="linkedin"
        size="clamp"
      />
      <SocialIcon
        href="https://ko-fi.com/igorskyflyer"
        label="Support on Ko-fi"
        variant="kofi"
        size="clamp"
      />
      <SocialIcon
        href="/contact/"
        label="Contact igorskyflyer via email"
        variant="email"
        size="clamp"
        inbound={true}
      />
      <SocialIcon
        href="https://instagram.com/igorskyflyer"
        label="igorskyflyer's Instagram profile"
        variant="instagram"
        size="clamp"
      />
    </nav>

    <div class="footer-divider"></div>

    <div class="footer-content">
      <nav
        class="footer-links"
        aria-label="Footer Navigation">
        <a href="/about/">About</a>
        <span class="dot-separator">•</span>
        <a href="/privacy/">Privacy</a>
        <span class="dot-separator">•</span>
        <a href="/rss.xml">RSS Feed</a>
      </nav>

      <p class="footer-meta">
        Built with <span
          class="footer-heart"
          aria-label="love"
          >&hearts;</span
        > and
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="astro-link"
          >🚀 Astro</a
        > by
        <a
          href="/igorskyflyer/"
          class="footer-author"
          >Igor Dimitrijević</a
        >
      </p>

      <p class="footer-copyright">
        &copy; {getYear()} Igor Dimitrijević. All rights reserved.
        <br />
        {
          import.meta.env.PROD && (
            <em>
              Version: <strong>{Date.now()}</strong>
            </em>
          )
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    box-sizing: border-box;
    margin-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(11, 15, 23, 0.8) 20%,
      rgba(5, 12, 28, 0.95) 100%
    );
    padding: 3rem 1rem 5rem 1rem;
    width: 100%;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    margin: 0 auto;
    max-width: 900px;
  }

  footer {
    margin-top: 2rem;
    background: linear-gradient(to bottom, var(--bg-color), #052664);
    padding: 2rem 0.5rem 3.5rem 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }

  footer [data-icon] {
    width: 36px;
    height: 36px;
  }

  footer a {
    color: #fff;
  }

  #footer-author {
    transition: font-weight cubic-bezier(0.55, 0.055, 0.675, 0.19) 100ms;
    color: var(--link);
  }

  #footer-author:hover {
    font-weight: bold;
  }

  #footer-heart {
    color: #f00;
    font-size: 1.4em;
  }

  .social-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 0.75rem);
  }

  .footer-divider {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.15),
      transparent
    );
    width: 100%;
    max-width: 200px;
    height: 1px;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .footer-links a {
    transition: color 150ms ease;
    color: #94a3b8;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--link, #0ea8ff);
  }

  .dot-separator {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.75rem;
  }

  .footer-meta {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .footer-heart {
    display: inline-block;
    color: #ff4d4d;
    font-size: 1.1em;
  }

  .astro-link,
  .footer-author {
    transition: color 150ms ease;
    color: #e2e8f0;
    font-weight: 500;
    text-decoration: none;
  }

  .footer-author {
    color: var(--link, #0ea8ff);
  }

  .astro-link:hover,
  .footer-author:hover {
    text-decoration: underline;
  }

  .footer-copyright {
    margin: 0;
    color: #64748b;
    font-size: 0.775rem;
  }

  @media screen and (min-width: 768px) {
    footer {
      font-size: 1.1rem;
    }

    footer [data-icon] {
      width: 48px;
      height: 48px;
    }
  }
</style>
