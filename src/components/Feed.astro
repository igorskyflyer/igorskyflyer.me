        ]
      }
    ]
  },
  {
    category: 'npm',
    date: '2025-08-21',
    title: 'Executing scope-migration',
    details: [
      {
        text: 'Migrating packages from @igor.dvlpr to @igorskyflyer and adapting all npm packages to security requirements',
        links: [
          {
            text: '@igor.dvlpr',
            url: 'https://www.npmjs.com/~igor.dvlpr'
