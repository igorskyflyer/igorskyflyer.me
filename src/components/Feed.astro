activities.sort((a, b) => b.date.localeCompare(a.date))
---

<section class="feed-container">
  <div class="feed-header">
    <div class="header-title">
      <span class="feed-icon">📋</span>
      <h2>{title}</h2>
    </div>
    <div class="feed-status">
      <span class="status-dot"></span>
      <span class="status-text">LIVE FEED</span>
    </div>
  </div>

  <div class="feed">
    {
      activities.map((item) => {
        const hasDetails = item.details && item.details.length > 0
        const hasDetailLinks = item.details?.some(
          (detail) =>
            Boolean(detail.link) ||
            Boolean(detail.links && detail.links.length > 0)
        )

        return hasDetails ? (
          <details class="feed-item">
            <summary class="item-summary">
              <div class="item-row">
                <span class="item-meta">
                  <span class={`badge ${categoryBadges[item.category].class}`}>
                    {categoryBadges[item.category].label}
                  </span>
                  <time class="item-date">{formatDate(item.date)}</time>
                </span>
                <span class="item-title">{item.title}</span>
              </div>
              <span
                class="toggle-icon"
                aria-hidden="true"
              />
            </summary>

            <div class="details-wrapper">
              <div class="details-content">
                {item.details!.length > 1 ? (
                  <ul class="item-details">
                    {item.details!.map((detail) => (
                      <li>
                        {detail.link ? (
                          <a
                            href={detail.link}
                            target="_blank"
                            rel="noopener noreferrer">
                            {detail.text}
                          </a>
                        ) : (
                          detail.text
                        )}

                        {detail.postText && ` ${detail.postText}`}

                        {detail.links && detail.links.length > 0 && (
                          <span class="detail-inline-links">
                            {' ('}
                            {detail.links.map((lnk, idx) => (
                              <>
                                <a
                                  href={lnk.url}
                                  target="_blank"
                                  rel="noopener noreferrer">
                                  {lnk.text}
                                </a>
                                {idx < detail.links!.length - 1 && ', '}
                              </>
                            ))}
                            {')'}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="item-details">
                    {item.details![0].link ? (
                      <a
                        href={item.details![0].link}
                        target="_blank"
                        rel="noopener noreferrer">
                        {item.details![0].text}
                      </a>
                    ) : (
                      item.details![0].text
                    )}

                    {item.details![0].postText &&
                      ` ${item.details![0].postText}`}

                    {item.details![0].links &&
                      item.details![0].links.length > 0 && (
                        <span class="detail-inline-links">
                          {' ('}
                          {item.details![0].links.map((lnk, idx) => (
                            <>
                              <a
                                href={lnk.url}
                                target="_blank"
                                rel="noopener noreferrer">
                                {lnk.text}
                              </a>
                              {idx < item.details![0].links!.length - 1 && ', '}
                            </>
                          ))}
                          {')'}
                        </span>
                      )}
                  </p>
                )}

                {item.titleLink && !hasDetailLinks && (
                  <div class="details-main-link">
                    <a
                      href={item.titleLink}
                      target="_blank"
                      rel="noopener noreferrer">
                      Open link ↗
                    </a>
                  </div>
                )}
              </div>
            </div>
          </details>
        ) : (
          <article class="feed-item feed-item--flat">
            <div class="item-row">
              <span class="item-meta">
                <span class={`badge ${categoryBadges[item.category].class}`}>
                  {categoryBadges[item.category].label}
                </span>
                <time class="item-date">{formatDate(item.date)}</time>
              </span>
              <span class="item-title">
                {item.titleLink ? (
                  <a
                    href={item.titleLink}
                    target="_blank"
                    rel="noopener noreferrer">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </span>
            </div>
          </article>
        )
      })
    }

    <div id="feed-timeline">
      <div>
        <svg
          width="24"
          height="48"
          viewBox="0 0 24 48"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true">
          <defs>
            <filter
              id="node-glow"
              x="-50%"
              y="-50%"
              width="200%"
              height="200%">
              <feDropShadow
                dx="0"
                dy="0"
                stdDeviation="3"
                flood-color="#3abfc7"
                flood-opacity="0.8"
              ></feDropShadow>
            </filter>
          </defs>

          <line
            x1="12"
            y1="0"
            x2="12"
            y2="16"
            stroke="#3abfc7"
            stroke-width="2.5"
            stroke-opacity="0.6"
          ></line>

          <circle
            cx="12"
            cy="24"
            r="6"
            fill="#3abfc7"
            filter="url(#node-glow)"
          ></circle>

          <line
            x1="12"
            y1="32"
            x2="12"
            y2="48"
            stroke="#3abfc7"
            stroke-width="2.5"
            stroke-opacity="0.6"
          ></line>
        </svg>
        <a href="/timeline">Explore full historical timeline &#x2794;</a>
      </div>
      <p>150+ more events</p>
    </div>
  </div>
</section>

<style>
  .feed-container {
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius, 8px);
    background: rgba(13, 17, 23, 0.7);
    width: 100%;
    overflow: hidden;
  }

  .feed-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(
      to bottom,
      rgba(58, 191, 199, 0.08),
      var(--bg-color)
    );
    padding: 0.85rem 1.25rem;
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-title h2 {
    margin: 0;
    color: #fff;
    font-weight: 600;
    font-size: clamp(1.15rem, 3.5vw, 1.5rem);
  }

  .feed-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #94a3b8;
    font-weight: bolder;
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    letter-spacing: 0.05em;
  }

  .status-dot {
    animation: pulse 2s infinite;
    box-shadow: 0 0 8px #1fe066;
    border-radius: 50%;
    background-color: #1fe066;
    width: 8px;
    height: 8px;
  }

  .feed {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
  }

  .feed-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: background-color 150ms ease;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.85rem 1.25rem;
  }

  .feed-item:last-child {
    border-bottom: none;
  }

  .feed-item:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .item-row {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .item-summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    width: 100%;
    list-style: none !important;
  }

  .item-summary::-webkit-details-marker {
    display: none !important;
  }

  .item-summary:focus-visible {
    outline: 2px solid var(--link, #0ea8ff);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .toggle-icon {
    position: relative;
    flex-shrink: 0;
    margin-top: 0.25rem;
    width: 14px;
    height: 14px;
  }

  .toggle-icon::before,
  .toggle-icon::after {
    position: absolute;
    transition:
      transform 150ms ease,
      opacity 180ms ease;
    border-radius: 1px;
    background-color: var(--accent);
    content: '';
  }

  .toggle-icon::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
  }

  .toggle-icon::after {
    top: 0;
    left: 6px;
    width: 2px;
    height: 14px;
  }

  .feed-item[open] .toggle-icon::after {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }

  .feed-item[open] .toggle-icon::before {
    transform: rotate(180deg);
  }

  .details-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 150ms ease,
      opacity 180ms ease;
  }

  .details-content {
    overflow: hidden;
  }

  .feed-item[open] .details-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .item-meta {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .badge {
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    font-weight: 600;
    font-size: clamp(0.7rem, 1.8vw, 0.8rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .badge-git {
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }

  .badge-npm {
    border: 1px solid rgba(248, 113, 113, 0.3);
    background: rgba(248, 113, 113, 0.15);
    color: #f87171;
  }

  .badge-entity {
    border: 1px solid rgba(250, 204, 21, 0.3);
    background: rgba(250, 204, 21, 0.15);
    color: #facc15;
  }

  .badge-pr {
    border: 1px solid rgba(192, 132, 252, 0.3);
    background: rgba(192, 132, 252, 0.15);
    color: #c084fc;
  }

  .badge-release {
    border: 1px solid rgba(74, 222, 128, 0.3);
    background: rgba(74, 222, 128, 0.15);
    color: #4ade80;
  }

  .badge-media {
    border: 1px solid rgba(244, 114, 182, 0.3);
    background: rgba(244, 114, 182, 0.15);
    color: #f472b6;
  }

  .badge-cert {
    border: 1px solid rgba(45, 212, 191, 0.3);
    background: rgba(45, 212, 191, 0.15);
    color: #2dd4bf;
  }

  .badge-general {
    border: 1px solid rgba(148, 163, 184, 0.3);
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
  }

  .item-date {
    color: #64748b;
    font-size: clamp(0.7rem, 1.5vw, 0.75rem);
  }

  .item-title {
    flex: 1;
    margin: 0;
    min-width: 0;
    max-width: 64ch;
    color: #e2e8f0;
    font-size: clamp(0.95rem, 2.5vw, 1.125rem);
    line-height: 1.4;
    word-break: break-word;
  }

  .item-title a,
  .item-details a,
  .details-main-link a {
    color: var(--link, #0ea8ff);
    text-decoration: none;
  }

  .item-title a:hover,
  .item-details a:hover,
  .details-main-link a:hover {
    text-decoration: underline;
  }

  .details-main-link {
    margin-top: 0.6rem;
    font-size: clamp(0.85rem, 2vw, 0.95rem);
  }

  .item-details {
    margin: 0.4rem 0 0 0;
    color: #94a3b8;
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    line-height: 1.5;
  }

  ul.item-details {
    padding-left: 1.2rem;
  }

  p.item-details {
    padding-left: 0;
  }

  .item-details li {
    margin-bottom: 0.2rem;
  }

  .detail-inline-links {
    color: #64748b;
  }

  #feed-timeline {
    border-bottom-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    background: linear-gradient(
      to bottom,
      var(--bg-color),
      rgba(58, 191, 199, 0.08)
    );
    padding: 0.4rem 0;
    color: #3abfc7;
    text-align: center;
    text-transform: uppercase;
  }

  #feed-timeline div {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  #feed-timeline a {
    font-weight: bolder;
    font-size: clamp(1rem, 0.8rem + 0.75vw, 1.5rem);
  }

  #feed-timeline p {
    font-size: 0.8rem;
    font-style: italic;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }

    .toggle-icon::before,
    .toggle-icon::after,
    .details-wrapper,
    .feed-item {
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .item-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
    }

    .item-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding-top: 0.1rem;
      min-width: 110px;
    }

    .toggle-icon {
      align-self: center;
      margin-top: 0;
    }
  }
</style>
