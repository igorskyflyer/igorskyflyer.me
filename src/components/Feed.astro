---

<section class="feed-container">
  <div class="feed-header">
    <div class="header-title">
      <span class="feed-icon">📋</span>
      <h2>{title}</h2>
    </div>
    <div class="feed-status">
      <span class="status-dot"></span>
      <span class="status-text">LIVE FEED</span>
    </div>
  </div>

  <div class="feed">
    {
      activities.map((item) => {
        const hasDetails = item.details && item.details.length > 0

        const Row = (
          <>
            <span class="item-meta">
              <span class={`badge ${categoryBadges[item.category].class}`}>
                {categoryBadges[item.category].label}
              </span>
              {item.date && <time class="item-date">{item.date}</time>}
            </span>
            <span class="item-title">
              {item.titleLink ? (
                <a
                  href={item.titleLink}
                  target="_blank"
                  rel="noopener noreferrer">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </span>
          </>
        )

        return hasDetails ? (
          <details class="feed-item">
            <summary class="item-summary">
              <div class="item-row">{Row}</div>
              <span
                class="toggle-icon"
                aria-hidden="true"
              />
            </summary>

            <div class="details-wrapper">
              <div class="details-content">
                <ul class="item-details">
                  {item.details!.map((detail) => (
                    <li>
                      {detail.link ? (
                        <a
                          href={detail.link}
                          target="_blank"
                          rel="noopener noreferrer">
                          {detail.text}
                        </a>
                      ) : (
                        detail.text
                      )}

                      {detail.postText && ` ${detail.postText}`}

                      {detail.links && detail.links.length > 0 && (
                        <span class="detail-inline-links">
                          {' ('}
                          {detail.links.map((lnk, idx) => (
                            <>
                              <a
                                href={lnk.url}
                                target="_blank"
                                rel="noopener noreferrer">
                                {lnk.text}
                              </a>
                              {idx < detail.links!.length - 1 && ', '}
                            </>
                          ))}
                          {')'}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </details>
        ) : (
          <article class="feed-item feed-item--flat">
            <div class="item-row">{Row}</div>
          </article>
        )
      })
    }
  </div>
</section>

<style>
  .feed-container {
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius, 8px);
    background: rgba(13, 17, 23, 0.7);
    width: 100%;
    overflow: hidden;
  }

  .feed-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.3);
    padding: 0.85rem 1.25rem;
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-title h2 {
    margin: 0;
    color: #fff;
    font-weight: 600;
    font-size: 1.5rem;
  }

  .feed-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #94a3b8;
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .status-dot {
    animation: pulse 2s infinite;
    box-shadow: 0 0 8px #1fe066;
    border-radius: 50%;
    background-color: #1fe066;
    width: 8px;
    height: 8px;
  }

  .feed {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
  }

  .feed-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: background-color 150ms ease;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.85rem 1.25rem;
  }

  .feed-item:last-child {
    border-bottom: none;
  }

  .feed-item:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .item-row {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .item-summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    width: 100%;
    list-style: none !important;
  }

  .item-summary::-webkit-details-marker {
    display: none !important;
  }

  .item-summary:focus-visible {
    outline: 2px solid var(--link, #0ea8ff);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .toggle-icon {
    position: relative;
    flex-shrink: 0;
    margin-top: 0.25rem;
    width: 14px;
    height: 14px;
  }

  .toggle-icon::before,
  .toggle-icon::after {
    position: absolute;
    transition:
      transform 150ms ease,
      opacity 180ms ease;
    border-radius: 1px;
    background-color: var(--accent);
    content: '';
  }

  .toggle-icon::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
  }

  .toggle-icon::after {
    top: 0;
    left: 6px;
    width: 2px;
    height: 14px;
  }

  .feed-item[open] .toggle-icon::after {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }

  .feed-item[open] .toggle-icon::before {
    transform: rotate(180deg);
  }

  .details-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 150ms ease,
      opacity 180ms ease;
  }

  .details-content {
    overflow: hidden;
  }

  .feed-item[open] .details-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .item-meta {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .badge-git {
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: rgba(56, 189, 248, 0.15);
    color: #38bdd8;
  }

  .badge-npm {
    border: 1px solid rgba(204, 53, 52, 0.3);
    background: rgba(204, 53, 52, 0.15);
    color: #ff6b6b;
  }

  .badge-entity {
    border: 1px solid rgba(234, 179, 8, 0.3);
    background: rgba(234, 179, 8, 0.15);
    color: #facc15;
  }

  .badge-pr {
    border: 1px solid rgba(168, 85, 247, 0.3);
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
  }

  .badge-release {
    border: 1px solid rgba(34, 197, 94, 0.3);
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
  }

  .badge-media {
    border: 1px solid rgba(239, 68, 68, 0.3);
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }

  .item-date {
    color: #64748b;
    font-size: 0.75rem;
  }

  .item-title {
    margin: 0;
    color: #e2e8f0;
    font-size: 0.9rem;
    line-height: 1.4;
    word-break: break-word;
  }

  .item-title a,
  .item-details a {
    color: var(--link, #0ea8ff);
    text-decoration: none;
  }

  .item-title a:hover,
  .item-details a:hover {
    text-decoration: underline;
  }

  .item-details {
    margin: 0.75rem 0 0 0;
    padding-left: 1.2rem;
    color: #94a3b8;
    font-size: 0.825rem;
    line-height: 1.5;
  }

  .item-details li {
    margin-bottom: 0.2rem;
  }

  .detail-inline-links {
    color: #64748b;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }

    .toggle-icon::before,
    .toggle-icon::after,
    .details-wrapper,
    .feed-item {
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .item-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
    }

    .item-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding-top: 0.1rem;
      min-width: 110px;
    }

    .toggle-icon {
      align-self: center;
      margin-top: 0;
    }
  }
</style>
