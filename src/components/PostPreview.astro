---
import { postDate } from '@functions/posts.ts'
import PostExcerpt from '@igor.dvlpr/astro-post-excerpt'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { render } from 'astro:content'

const { post } = Astro.props
const { remarkPluginFrontmatter: data } = await render(post)

const minutesRead = data.minutesRead
const tags = post.data.tags || []
const postPublishedDate = postDate(post.data.publishDate)
---

<article class="post-card">
  <div class="post-body">
    <header class="post-header">
      <a
        href={`/blog/${post.id}/`}
        class="post-title-link">
        <h2 class="post-title">{post.data.title}</h2>
      </a>
    </header>

    <div class="post-excerpt-wrapper">
      <PostExcerpt
        post={post}
        words={32}
        addEllipsis={true}
        smartEllipsis={true}
        useConstraints="all"
      />
    </div>

    {
      tags.length > 0 && (
        <ul
          class="tag-list"
          aria-label="Post tags">
          {tags.map((tagName: string) => (
            <li>
              <a
                href={`/blog/tag/${tagName}/`}
                class="tag-badge">
                #{tagName}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <footer class="post-footer">
    <a
      href="/igorskyflyer/"
      class="author-link">
      <Image
        src="/assets/author/igorskyflyer-mini.webp"
        alt="Igor Dimitrijević"
        loading="lazy"
        width="44"
        height="44"
        class="author-avatar"
      />
      <span class="author-name">Igor Dimitrijević (igorskyflyer)</span>
    </a>

    <div class="meta-details">
      <span class="meta-item">
        <Icon
          name="mdi:clock-outline"
          class="meta-icon"
        />
        {postPublishedDate}
      </span>
      <span
        class="meta-dot"
        aria-hidden="true"
        >•</span
      >
      <span class="meta-item">
        <Icon
          name="ic:baseline-menu-book"
          class="meta-icon"
        />
        {minutesRead}
      </span>
    </div>
  </footer>
</article>

<style>
  .post-card {
    display: flex;
    position: relative;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
    box-sizing: border-box;
    border: 1px solid #30363d;
    border-radius: 12px;
    background-color: #0d1117;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    height: 100%;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.4),
      0 0 16px rgba(88, 166, 255, 0.15);
    border-color: #58a6ff;
    background-color: #161b22;
  }

  .post-body {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
  }

  .post-title-link {
    text-decoration: none;
  }

  .post-title-link::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
  }

  .post-title {
    transition: color 150ms ease;
    margin: 0 0 0.85rem 0;
    color: #f0f6fc;
    font-weight: 700;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.35;
  }

  .post-card:hover .post-title {
    color: #58a6ff;
  }

  .post-excerpt-wrapper {
    margin-bottom: 1.25rem;
    color: #8b949e;
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    line-height: 1.6;
  }

  .post-excerpt-wrapper :global(p) {
    margin: 0;
    color: #8b949e;
  }

  .tag-list,
  .post-footer {
    position: relative;
    z-index: 2;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 1.25rem 0;
    padding: 0;
    list-style: none;
  }

  .tag-badge {
    display: inline-block;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
    border: 1px solid rgba(56, 139, 253, 0.25);
    border-radius: 20px;
    background-color: rgba(56, 139, 253, 0.1);
    padding: 0.2rem 0.65rem;
    color: #58a6ff;
    font-weight: 500;
    font-size: 0.78rem;
    text-decoration: none;
  }

  .tag-badge:hover {
    border-color: #58a6ff;
    background-color: #1f6beb;
    color: #ffffff;
  }

  .post-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    border-top: 1px solid #21262d;
    padding-top: 1rem;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #c9d1d9;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .author-link:hover .author-name {
    color: #58a6ff;
    text-decoration: underline;
  }

  .author-avatar {
    border: 1px solid #30363d;
    border-radius: 50%;
    object-fit: cover;
  }

  .meta-details {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #8b949e;
    font-size: 0.8rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .meta-icon {
    width: 15px;
    height: 15px;
    color: #8b949e;
  }

  .meta-dot {
    opacity: 0.5;
  }

  @media screen and (max-width: 480px) {
   .tag-badge {
     margin-top: 0.7rem;
   }
  }
</style>
