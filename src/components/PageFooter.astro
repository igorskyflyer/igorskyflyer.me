---
import { getLocalDate, getYear } from '@functions/utilities.ts'
import { Icon } from 'astro-icon/components'

const year = getYear()

const socialLinks = [
  {
    href: 'https://github.com/igorskyflyer',
    label: 'GitHub Profile',
    icon: 'mdi:github',
    className: 'github',
    external: true
  },
  {
    href: 'https://youtube.com/@igorskyflyer',
    label: 'YouTube Channel',
    icon: 'ri:youtube-fill',
    className: 'youtube',
    external: true
  },
  {
    href: 'https://linkedin.com/in/igorskyflyer',
    label: 'LinkedIn Profile',
    icon: 'mdi:linkedin',
    className: 'linkedin',
    external: true
  },
  {
    href: 'https://ko-fi.com/igorskyflyer',
    label: 'Support on Ko-fi',
    icon: 'cib:ko-fi',
    className: 'kofi',
    external: true
  },
  {
    href: '/contact/',
    label: 'Contact Me',
    icon: 'ic:outline-email',
    className: 'email',
    external: false
  },
  {
    href: 'https://instagram.com/igorskyflyer',
    label: 'Instagram Profile',
    icon: 'mdi:instagram',
    className: 'instagram',
    external: true
  }
]
---

<footer class="site-footer">
  <div class="footer-container">
    <nav
      class="social-nav"
      aria-label="Social Links">
      {
        socialLinks.map((item) => (
          <a
            href={item.href}
            rel={item.external ? 'external noopener noreferrer' : undefined}
            target={item.external ? '_blank' : undefined}
            aria-label={item.label}
            title={item.label}
            class={`social-icon-link social-${item.className}`}>
            <Icon
              name={item.icon}
              class="social-icon"
            />
          </a>
        ))
      }
    </nav>

    <div class="footer-divider"></div>

    <div class="footer-content">
      <nav
        class="footer-links"
        aria-label="Footer Navigation">
        <a href="/about/">About</a>
        <span class="dot-separator">•</span>
        <a href="/privacy/">Privacy</a>
        <span class="dot-separator">•</span>
        <a href="/rss.xml">RSS Feed</a>
      </nav>

      <p class="footer-meta">
        Built with <span
          class="footer-heart"
          aria-label="love"
          >&hearts;</span
        > and
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="astro-link"
          >🚀 Astro</a
        > by
        <a
          href="/igorskyflyer/"
          class="footer-author"
          >Igor Dimitrijević</a
        >
      </p>

      <p class="footer-copyright">
        &copy; {year} Igor Dimitrijević. All rights reserved.
        <br />
        {
          import.meta.env.PROD && (
            <em>
              Version: <strong>{getLocalDate()}</strong>
            </em>
          )
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    box-sizing: border-box;
    margin-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(11, 15, 23, 0.8) 20%,
      rgba(5, 12, 28, 0.95) 100%
    );
    padding: 3rem 1rem 5rem 1rem;
    width: 100%;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    margin: 0 auto;
    max-width: 900px;
  }

  footer {
    margin-top: 2rem;
    background: linear-gradient(to bottom, var(--bg-color), #052664);
    padding: 2rem 0.5rem 3.5rem 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }

  footer [data-icon] {
    width: 36px;
    height: 36px;
  }

  footer a {
    color: #fff;
  }

  #footer-author {
    transition: font-weight cubic-bezier(0.55, 0.055, 0.675, 0.19) 100ms;
    color: var(--link);
  }

  #footer-author:hover {
    font-weight: bold;
  }

  #footer-heart {
    color: #f00;
    font-size: 1.4em;
  }

  .social-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 0.75rem);
  }

  .social-icon-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    width: clamp(44px, 12vw, 64px);
    height: clamp(44px, 12vw, 64px);
    color: #94a3b8;
  }

  .social-icon-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 16px rgba(14, 168, 255, 0.25);
    border-color: var(--link, #0ea8ff);
    background-color: var(--primary, #002f9c);
    color: #fff;
  }

  .social-icon {
    width: clamp(28px, 8vw, 44px);
    height: clamp(28px, 8vw, 44px);
  }

  .footer-divider {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.15),
      transparent
    );
    width: 100%;
    max-width: 200px;
    height: 1px;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .footer-links a {
    transition: color 150ms ease;
    color: #94a3b8;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--link, #0ea8ff);
  }

  .dot-separator {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.75rem;
  }

  .footer-meta {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .footer-heart {
    display: inline-block;
    color: #ff4d4d;
    font-size: 1.1em;
  }

  .astro-link,
  .footer-author {
    transition: color 150ms ease;
    color: #e2e8f0;
    font-weight: 500;
    text-decoration: none;
  }

  .footer-author {
    color: var(--link, #0ea8ff);
  }

  .astro-link:hover,
  .footer-author:hover {
    text-decoration: underline;
  }

  .footer-copyright {
    margin: 0;
    color: #64748b;
    font-size: 0.775rem;
  }

  .social-github:hover {
    border-color: #6a737d;
    background-color: #24292e;
  }

  .social-linkedin:hover {
    border-color: #70b5ff;
    background-color: #0a66c2;
  }

  .social-npm:hover {
    border-color: #ff8b8a;
    background-color: #cb3837;
  }

  .social-email:hover {
    border-color: #ffb380;
    background-color: #ff6600;
  }

  .social-github:hover {
    box-shadow: 0 0 20px 4px rgba(106, 115, 125, 0.7);
    border-color: #6a737d;
    background-color: #24292e;
  }

  .social-linkedin:hover {
    box-shadow: 0 0 20px 4px rgba(112, 181, 255, 0.7);
    border-color: #70b5ff;
    background-color: #0a66c2;
  }

  .social-npm:hover {
    box-shadow: 0 0 20px 4px rgba(255, 139, 138, 0.7);
    border-color: #ff8b8a;
    background-color: #cb3837;
  }

  .social-email:hover {
    box-shadow: 0 0 20px 4px rgba(255, 179, 128, 0.7);
    border-color: #ffb380;
    background-color: #ff6600;
  }

  .social-kofi:hover {
    box-shadow: 0 0 20px 4px rgba(255, 158, 175, 0.7);
    border-color: #ff9eaf;
    background-color: #ff5e5b;
  }

  .social-instagram:hover {
    box-shadow: 0 0 20px 4px rgba(255, 118, 173, 0.7);
    border-color: #ff76ad;
    background-color: #e1306c;
  }

  .social-youtube:hover {
    box-shadow: 0 0 20px 4px rgba(255, 102, 102, 0.7);
    border-color: #ff6666;
    background-color: #ff0000;
  }

  @media screen and (min-width: 768px) {
    footer {
      font-size: 1.1rem;
    }

    footer [data-icon] {
      width: 48px;
      height: 48px;
    }
  }
</style>
