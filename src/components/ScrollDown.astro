---
interface Props {
  color?: string
  size?: string
}

const { color = '#ffffff', size = '14px' } = Astro.props
---

<button
  class="scroll-container"
  aria-label="Scroll down">
  <span class="arrow-down"></span>
  <span class="arrow-down"></span>
</button>

<style define:vars={{ color, size }}>
  .scroll-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    margin: 0 auto;
    outline: none;
    border: none;
    background: none;
    padding: 10px;
  }

  .arrow-down {
    display: block;
    transform: rotate(45deg);
    animation: arrow-loop 2s infinite;
    margin: -4px 0;
    border-right: 3px solid var(--color);
    border-bottom: 3px solid var(--color);
    width: var(--size);
    height: var(--size);
  }

  .arrow-down:nth-child(2) {
    animation-delay: -0.2s;
  }

  @keyframes arrow-loop {
    0% {
      transform: rotate(45deg) translate(-5px, -5px);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: rotate(45deg) translate(5px, 5px);
      opacity: 0;
    }
  }
</style>

<script>
  const setupScrollButton = () => {
    const btn = document.querySelector('.scroll-container')

    if (btn) {
      if (btn.hasAttribute('data-bound')) return
      btn.setAttribute('data-bound', 'true')

      btn.addEventListener('click', () => {
        const targetElement = document.querySelector('[data-target]')

        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth' })
        } else {
          window.scrollBy({ top: window.innerHeight * 0.8, behavior: 'smooth' })
        }
      })
    }
  }

  setupScrollButton()

  document.addEventListener('astro:after-swap', setupScrollButton)
</script>
