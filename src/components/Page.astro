---
import NavBtn from '@components/NavBtn.astro'
import PageFooter from '@components/PageFooter.astro'
import PageHead from '@components/PageHead.astro'
import PageHeader from '@components/PageHeader.astro'
import type { PageProps } from '@interfaces/PageProps.ts'

const {
  title = '',
  description = '',
  featuredImage = '',
  keywords = '',
  pageTitle = '',
  pageTagline = ''
} = Astro.props as PageProps
---

<!doctype html>
<html
  lang="en"
  dir="ltr">
  <PageHead
    title={title}
    description={description}
    keywords={keywords}
    featuredImage={featuredImage}>
    <slot name="head" />
  </PageHead>
  <body>
    <PageHeader />
    <header class="page-header">
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-tagline">{pageTagline}</p>
    </header>

    <main>
      <slot name="body" />
    </main>
    <NavBtn />
    <PageFooter />
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 10vw, 8.5rem);
    margin: 3rem auto;
    width: 92%;
  }

  main a,
  main a:visited {
    color: var(--link);
    text-decoration: none;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 0.85rem);
    margin: 3rem auto 0 auto;
    max-width: 80%;
    text-align: center;
  }

  .page-title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .page-tagline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    max-width: 65ch;
    color: #94a3b8;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    line-height: 1.5;
  }

  @media screen and (min-width: 768px) {
    main {
      width: 88%;
    }
  }
</style>
