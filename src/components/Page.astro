---
import NavBtn from '@components/NavBtn.astro'
import PageFooter from '@components/PageFooter.astro'
import PageHead from '@components/PageHead.astro'
import PageHeader from '@components/PageHeader.astro'
import type { PageProps } from '@interfaces/PageProps.ts'

const {
  title = '',
  description = '',
  featuredImage = '',
  keywords = '',
  isHome = false
} = Astro.props as PageProps

if (isHome) {
  await import('@ui/home.css')
}
---

<!doctype html>
<html
  lang="en"
  dir="ltr">
  <PageHead
    title={title}
    description={description}
    keywords={keywords}
    featuredImage={featuredImage}>
    <slot name="head" />
  </PageHead>
  <body>
    <PageHeader />
    <main class:list={[{ hero: isHome }]}>
      <slot name="body" />
    </main>
    <NavBtn />
    <PageFooter />
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 10vw, 8.5rem);
    margin: 3rem auto;
    width: 92%;
  }

  main a,
  main a:visited {
    color: var(--link);
    text-decoration: none;
  }

  @media screen and (min-width: 768px) {
    main {
      width: 88%;
    }
  }
</style>
